NODE_ENV=development
PORT=4000

# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/ueibi_dev"

FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Email (SMTP / Zoho / SendGrid / Console)
MAIL_TRANSPORT=smtp
MAIL_HOST=mail.ueibi.com
MAIL_ENCRYPTION=ssl
MAIL_PORT=465
MAIL_USERNAME=administrator@ueibi.com
MAIL_PASSWORD=your_password_here
MAIL_FROM_ADDRESS=noreply@ueibi.com
SENDGRID_API_KEY=
UEIBI_NOTIFY_EMAIL=ops@ueibi.local

# Registration workflow
LICENSE_UNIT_PRICE=3999
GST_RATE=0.18
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
ACTION_TOKEN_TTL_DAYS=14

# Must match the ueibi-new frontend's APP_PASSWORD (used to gate the admin Coupons page)
APP_PASSWORD=YourStrongPasswordHere
ADMIN_SESSION_COOKIE_NAME=admin_session
ADMIN_SESSION_TTL_MS=86400000
