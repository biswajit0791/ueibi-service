NODE_ENV=development
PORT=4000

# PostgreSQL Connection String: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ueibi_dev"

# Frontend Origin for CORS & Email Links
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Email Configuration (SMTP / SendGrid / Console)
MAIL_TRANSPORT=smtp
MAIL_HOST=mail.ueibi.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=administrator@ueibi.com
MAIL_PASSWORD=your_smtp_password_here
MAIL_FROM_ADDRESS=noreply@ueibi.com
# SENDGRID_API_KEY=your_sendgrid_key_here
# UEIBI_NOTIFY_EMAIL=ops@ueibi.local

# Registration Workflow & Business Settings
LICENSE_UNIT_PRICE=3999
GST_RATE=0.18
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
ACTION_TOKEN_TTL_DAYS=14

# Admin Authentication & Sessions
APP_PASSWORD=your_admin_secret_password_here
ADMIN_SESSION_COOKIE_NAME=admin_session
ADMIN_SESSION_TTL_MS=86400000

# Dedicated JWT Secret (Generate a strong 256-bit secret)
JWT_SECRET=your_jwt_secret_here_min_32_characters
