  updatedAt      DateTime    @updatedAt

  @@index([tenantId])
  @@index([employeeId, financialYear])
  @@map("training_records")
}

model Achievement {
  id            String     @id @default(cuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      TenantUser @relation("AchievementEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  title         String
  description   String     @db.Text
  category      String?
  occurredOn    DateTime
  financialYear String?
  createdById   String
  createdBy     TenantUser @relation("AchievementCreator", fields: [createdById], references: [id])
  createdAt     DateTime   @default(now())

  @@index([tenantId])
  @@index([employeeId, financialYear])
  @@map("achievements")
}

model Incident {
  id              String     @id @default(cuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        TenantUser @relation("IncidentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  title           String
  description     String     @db.Text
  severity        String     @default("LOW") // LOW | MEDIUM | HIGH | CRITICAL
  status          String     @default("OPEN") // OPEN | RESOLVED | ESCALATED
  occurredOn      DateTime
  financialYear   String?
  reportedById    String
  reportedBy      TenantUser @relation("IncidentReporter", fields: [reportedById], references: [id])
  resolutionNotes String?    @db.Text
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([tenantId])
  @@index([employeeId, financialYear])
  @@map("incidents")
