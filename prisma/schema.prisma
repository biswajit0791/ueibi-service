  tenantId  String
  postId    String
  post      GalleryPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    TenantUser  @relation("GalleryCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  text      String      @db.Text
  createdAt DateTime    @default(now())
  /// Null until the comment is edited, so "(edited)" can be shown accurately
  /// rather than inferred by comparing timestamps.
  editedAt  DateTime?

  @@index([postId])
  @@index([authorId])
  @@map("gallery_comments")
}

// ─── Department Master List ───────────────────────────────────────────────────
// Tenant-scoped, RBAC-managed list of departments.
// Used to drive dropdowns across Employee Records, UER Team, Leave, etc.
// Names are stored as strings on employee records (no FK) — renaming a dept
// does NOT retroactively change historical employee records.
// ─── Goal Option Master Lists ─────────────────────────────────────────────────
// Backs the Category / Goal Type / Priority dropdowns on the goal form.
// One table with a `kind` discriminator rather than three near-identical tables:
// same CRUD, same admin UI, one migration.
//
// `label` and `value` are separate because priority DISPLAYS "Medium" but is
// STORED on the Goal as "medium". For category and type they are the same.
// Goal.category / Goal.goalType / Goal.priority hold the `value` as a plain
// string (no FK), so archiving is a soft-delete and renaming cascades.
model GoalOption {
  id       String         @id @default(cuid())
  tenantId String
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind     GoalOptionKind

  label String // shown in the dropdown, e.g. "Medium"
  value String // persisted on the Goal, e.g. "medium"

  isActive  Boolean @default(true) // soft-delete: existing goals keep the value
  // Display order. For PRIORITY this is also the SEMANTIC rank (low < critical),
  // which is why lists must be ordered by this and never alphabetically.
  sortOrder Int     @default(0)
  // Optional accent for the chips/badges. Without one the UI falls back.
  color     String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, kind, value])
  @@index([tenantId, kind, isActive])
  @@map("goal_options")
}

enum GoalOptionKind {
  CATEGORY
  TYPE
  PRIORITY
}

// ─── Blood Group Master List ──────────────────────────────────────────────────
// Tenant-scoped, RBAC-managed list that feeds the Blood Group dropdown on the
// onboarding form and employee records. Modelled on Department rather than a
// hard-coded enum: the eight ABO/Rh groups cover almost everyone, but rare
// phenotypes exist (Bombay/hh is notably present in India, Rh-null elsewhere),
// and a fixed enum would need a migration every time one is needed.
model BloodGroup {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String // e.g. "O+", "AB-", "Bombay (hh)"
  isActive  Boolean  @default(true) // soft-delete — false = archived, keeps historical employee values valid
  sortOrder Int      @default(0)
  createdBy String? // TenantUser.id (null for seeded rows)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("blood_groups")
}

model Department {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String // e.g. "Engineering", "Design"
  description String?
  color       String? // optional hex e.g. "#6366f1"
  isActive    Boolean  @default(true) // soft-delete — false = archived
  createdBy   String? // TenantUser.id (nullable for seeded)
  sortOrder   Int      @default(0) // for custom ordering in the dropdown
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name]) // no duplicate names within a tenant
  @@index([tenantId, isActive])
  @@map("departments")
}

// ── Chat Messages ──────────────────────────────────────────────────────────
// ─── CXO Connect ──────────────────────────────────────────────────────────────
// Employee → leadership channel. Structurally a ticket with a reply thread,
// mirroring the Dispute module rather than inventing a second pattern.
//
// Anonymity: `raisedById` is ALWAYS stored, so abuse can be handled and the
// employee can follow their own thread under "My Messages". When
// `isAnonymous` is set the API never exposes the sender to leadership — the
// redaction lives in the service layer, not the schema.
model CxoMessage {
  id           String @id @default(cuid())
  tenantId     String
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Unique PER TENANT, not globally. The number is generated from a
  /// per-tenant sequence ("CXO-2026-0001" restarts for each company) and is
  /// display-only, so a global constraint made every tenant's first message
  /// collide with the first tenant's.
  ticketNumber String

  subject  String
  body     String      @db.Text
  category CxoCategory @default(SUGGESTION)
  status   CxoStatus   @default(PENDING)

  isAnonymous Boolean @default(false)

  raisedById String
  raisedBy   TenantUser @relation("CxoRaisedBy", fields: [raisedById], references: [id], onDelete: Cascade)

  // The leader this was addressed to. Nullable so a thread survives that
  // person leaving the company or losing the capability.
  targetLeaderId String?
  targetLeader   TenantUser? @relation("CxoTargetLeader", fields: [targetLeaderId], references: [id], onDelete: SetNull)

  // Whoever actually picked it up; usually the target, but reassignable.
  assignedToId String?
  assignedTo   TenantUser? @relation("CxoAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  dueAt       DateTime? // SLA — the "responds within 5 business days" promise
  closedAt    DateTime?
  lastReplyAt DateTime?

  // Unread bookkeeping, one side each.
  readByEmployeeAt   DateTime?
  readByLeadershipAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies CxoMessageReply[]

  @@unique([tenantId, ticketNumber])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, targetLeaderId, status])
  @@index([tenantId, raisedById, createdAt])
  @@map("cxo_messages")
}

model CxoMessageReply {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messageId String
  message   CxoMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  authorId String
  author   TenantUser @relation("CxoReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  body                 String  @db.Text
  // Distinguishes an official response from the employee's follow-up, so the
  // UI can style it and status transitions can key off it.
  isLeadershipResponse Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([messageId, createdAt])
  @@map("cxo_message_replies")
}

enum CxoCategory {
  APPRECIATION
  SUGGESTION
  CONCERN
  QUESTION
}

enum CxoStatus {
  PENDING
  ACKNOWLEDGED
  REPLIED
  CLOSED
}

// ─── Cross-cutting Capabilities ───────────────────────────────────────────────
// `TenantUser.role` is ONE value and encodes the HR hierarchy: who can create
// whom, who approves leave, who sees payroll. Some responsibilities are
// orthogonal to that — a Chief People Officer is an HR or EMPLOYEE in HR terms
// AND sits on the leadership panel. Forcing that into `role` would make them
// pick one identity and would break roleHierarchy.js.
//
// Capabilities are therefore ADDITIVE grants layered on top of `role`. Checks
// read `isElevated(user.role) || hasCapability(user, 'LEADERSHIP')`.
//
// NOTE: deliberately NOT a UserRole value. `dashboardPermissions.normalizeRole`
// maps the string 'LEADERSHIP' to SUPER_ADMIN, so making it a role would
// silently grant every leader super-admin dashboard visibility.
model UserCapability {
  id         String     @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String
  user       TenantUser @relation("UserCapabilities", fields: [userId], references: [id], onDelete: Cascade)
  capability Capability

  // Shown to employees when choosing who to write to, e.g. "Chief People Officer".
  title       String?
  grantedById String?
  grantedBy   TenantUser? @relation("CapabilityGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  @@unique([userId, capability])
  @@index([tenantId, capability])
  @@map("user_capabilities")
}

// Every grant and revoke of a capability, kept even after the capability row
// itself is deleted. Registry capabilities open access to PAN numbers and
// ex-employee conduct records, so "who widened access to this, and when" has to
// survive the revoke.
model CapabilityAuditLog {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  action     String // GRANT | REVOKE
  capability Capability

  // Who it was granted to / taken from.
  targetUserId String
  targetUser   TenantUser @relation("CapabilityAuditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  // Who did it. Nullable so the log survives that account being removed.
  actorId   String?
  actor     TenantUser? @relation("CapabilityAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorRole String?

  title     String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("capability_audit_logs")
}

enum Capability {
  LEADERSHIP // CXO Connect inbox

  // ── Registry / sub-login credentials ──
  // These back the "Granular Registry Credentials" checkboxes on the
  // Invite Recruiter modal. They are capabilities rather than roles because
  // "Recruiter" and "Viewer" are not UserRole values, and because a recruiter
  // needs registry access WITHOUT being made an admin.
  REGISTRY_SEARCH // run a registry search
  REGISTRY_WRITE // add & edit active employee registry records
  REGISTRY_ANALYTICS // verification analytics & billing history
  REGISTRY_EXPORT // download/export search results (separates Recruiter from Viewer)
}

// ─── Direct Messaging ─────────────────────────────────────────────────────────
// PostgreSQL is the source of truth for chat. Every write is mirrored into
// MongoDB (the read model) via a Kafka event; see services/messageMongo.service.js.
// `conversationId` is deterministic for a 1:1 pair — see lib/conversation.js.
model Message {
  id             String        @id @default(cuid())
  tenantId       String
  conversationId String
  senderId       String
  receiverId     String?
  text           String        @db.Text
  mediaUrl       String?
  mediaType      String?
  fileName       String?
  fileSize       Int?
  status         MessageStatus @default(SENT)
  deliveredAt    DateTime?
  readAt         DateTime?
  isDeleted      Boolean       @default(false)
  deletedFor     String[]      @default([])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([senderId])
  @@index([createdAt])
  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, receiverId, status])
  @@map("messages")
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

// ═══════════════════════════════════════════════════════════════════════════
// LEGAL DOCUMENTS
//
// The User Agreement and Privacy Policy shown at signup, authored by the
// platform owner rather than hardcoded in the frontend.
//
// Versioned on purpose. A legal agreement is only meaningful if you can show
// what someone actually agreed to on the day they agreed to it, so editing the
// terms creates a NEW version and never rewrites a published one. Each
// acceptance points at the exact version that was on screen.
//
// `bodyHtml` is authored HTML. It is sanitised on the SERVER before it is
// stored — the editor's own output is never trusted, because the thing being
// defended against is a payload reaching a public page.
// ═══════════════════════════════════════════════════════════════════════════

model LegalDocument {
  /// Stable identifier used in URLs and by the signup page: "user-agreement",
  /// "privacy-policy". Code refers to documents by slug, never by id, so a
  /// document can be recreated without breaking links.
  slug        String  @id
  title       String
  /// Shown under the heading on the public page, e.g. "Effective from 1 April".
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions LegalDocumentVersion[]

  @@map("legal_documents")
}

model LegalDocumentVersion {
  id           String        @id @default(cuid())
  documentSlug String
  document     LegalDocument @relation(fields: [documentSlug], references: [slug], onDelete: Cascade)
  /// 1, 2, 3 … per document. Unique, so two concurrent publishes cannot both
  /// claim the same number.
  version      Int
  title        String
  bodyHtml     String        @db.Text
  /// What changed, for the operator's own history.
  changeNote   String?       @db.Text
  /// Null while a draft. Only a published version is ever shown publicly, and
  /// a published version is never edited again.
  publishedAt  DateTime?
  /// Not a relation: the record must outlive the operator's account.
  authorId     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  acceptances LegalAcceptance[]

  @@unique([documentSlug, version])
  @@index([documentSlug, publishedAt])
  @@map("legal_document_versions")
}

/// Who agreed to what, and when. One row per document per acceptance, so
/// agreeing to two documents at signup writes two rows.
model LegalAcceptance {
  id             String               @id @default(cuid())
  versionId      String
  version        LegalDocumentVersion @relation(fields: [versionId], references: [id])
  /// Set for a signup; a tenant does not exist yet at that point.
  registrationId String?
  tenantId       String?
  userId         String?
  acceptedAt     DateTime             @default(now())
  /// Evidence of the acceptance, which is the entire point of the record.
  ipAddress      String?
  userAgent      String?              @db.Text

  @@index([registrationId])
  @@index([versionId])
  @@map("legal_acceptances")
}

// ═══════════════════════════════════════════════════════════════════════════
// INVOICE TEMPLATES
//
// The printed invoice, authored by the platform owner instead of hardcoded.
//
// Versioned for the same reason legal documents are: an invoice already sent
// to a customer must keep looking the way it looked when they received it, so
// editing the template creates a NEW version and each invoice remembers which
// version rendered it.
//
// `bodyHtml` is a Mustache template. It is sanitised on write, and publishing
// is refused unless the tokens a GST invoice legally requires are present —
// deleting {{issuerGstin}} by accident must not be able to produce invoices
// that fail an audit.
// ═══════════════════════════════════════════════════════════════════════════

model InvoiceTemplate {
  slug        String   @id
  title       String
  description String?
  /// Exactly one template is the default used for new invoices.
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions InvoiceTemplateVersion[]

  @@index([isDefault])
  @@map("invoice_templates")
}

model InvoiceTemplateVersion {
  id           String          @id @default(cuid())
  /// What the designer produced. Null on versions authored as raw HTML before
  /// the designer existed; those keep rendering through bodyHtml unchanged.
  settings     Json?
  templateSlug String
  template     InvoiceTemplate @relation(fields: [templateSlug], references: [slug], onDelete: Cascade)
  version      Int
  title        String
  bodyHtml     String          @db.Text
  /// Print-specific CSS, kept apart from the body so a layout tweak does not
  /// mean editing markup.
  css          String?         @db.Text
  changeNote   String?         @db.Text
  publishedAt  DateTime?
  authorId     String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  renderedInvoices Invoice[]

  @@unique([templateSlug, version])
  @@index([templateSlug, publishedAt])
  @@map("invoice_template_versions")
}

/// Platform-wide invoicing configuration. Exactly one row.
///
/// These values used to live in .env (GST_RATE, INVOICE_ISSUER_*), which meant
/// changing the tax rate or the registered address needed a deploy. They are
/// read with the env values as fallback, so behaviour before this row exists is
/// identical to what it was.
model InvoiceSetting {
  /// A fixed id rather than a findFirst, so concurrent writes cannot create a
  /// second settings row that silently wins half the time.
  id String @id @default("singleton")

  // ── Numbering ──
  /// The series is financial-year based and stays that way; only the prefix
  /// varies. Changing it mid-year starts a visibly different series, which the
  /// settings screen warns about.
  numberPrefix         String  @default("UEIBI")
  includeFinancialYear Boolean @default(true)
  /// A FLOOR, never an override. Allocation takes max(highest issued + 1, this),
  /// so lowering it can never reissue a number that already exists.
  nextNumber           Int     @default(1)

  // ── Regional ──
  currencyCode        String  @default("INR")
  currencySymbol      String  @default("₹")
  /// BEFORE or AFTER the amount.
  symbolPosition      String  @default("BEFORE")
  dateFormat          String  @default("DD MMM YYYY")
  defaultPaymentTerms String?

  // ── Tax ──
  /// Applies to invoices raised from now on. An issued invoice keeps the rate
  /// it was raised at, because its money is a snapshot.
  taxName    String  @default("GST")
  taxPercent Decimal @default(18) @db.Decimal(5, 2)

  // ── Who the invoice is from ──
  issuerName    String  @default("UEIBI")
  issuerGstin   String?
  issuerAddress String?

  // ── Uploaded marks ──
  signatureUrl String?
  sealUrl      String?

  /// Not a relation: the record must outlive the operator's account.
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("invoice_settings")
}
