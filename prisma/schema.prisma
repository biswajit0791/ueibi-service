generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Commercial lifecycle of a customer company. ACTIVE is the default and is
/// how every tenant behaved before this existed, so adding it changed nothing.
enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum OneOnOneStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum TenantStatus {
  ACTIVE
  TRIAL
  /// A lapsed TRIAL or subscription that still has access, pending payment.
  GRACE_PERIOD
  SUSPENDED
  EXPIRED
  /// Ended deliberately, as distinct from lapsing.
  CANCELLED
}

enum UserRole {
  // SUPER_ADMIN is the highest role WITHIN a company. PLATFORM_OWNER sits
  // outside the company hierarchy entirely — it is the operator of the platform
  // and holds no company-level permissions (see lib/roles.js, where it is
  // deliberately absent from ELEVATED_ROLES and friends).
  SUPER_ADMIN
  ADMIN
  CMD
  HR
  FINANCE
  MANAGER
  EMPLOYEE
  STUDENT
  MENTOR
  PLATFORM_OWNER
}

enum UserStatus {
  INVITED
  ACTIVE
  EXITED
}

model Tenant {
  id                   String                   @id @default(cuid())
  companyName          String
  domainName           String                   @unique
  tenantCode           String                   @unique
  licenseLimit         Int                      @default(0)
  // True only for the single internal tenant that houses PLATFORM_OWNER users.
  // Never set on a customer company.
  isPlatform           Boolean                  @default(false)
  status               TenantStatus             @default(ACTIVE)
  /// When a TRIAL lapses. Null means no expiry.
  planEndsAt           DateTime?
  suspendedAt          DateTime?
  suspendedReason      String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  users                TenantUser[]
  registrationId       String?                  @unique
  registration         CompanyRegistration?     @relation(fields: [registrationId], references: [id])
  exEmployeeRecords    ExEmployeeRecord[]
  nonJoinerRecords     NonJoinerRecord[]
  notifications        Notification[]
  goals                Goal[]
  goalAssignments      GoalAssignment[]
  tasks                Task[]
  policies             Policy[]
  policyAssignments    PolicyAssignment[]
  policyAcceptances    PolicyAcceptance[]
  policyAuditLogs      PolicyAuditLog[]
  appraisalCycles      AppraisalCycle[]
  appraisalParameters  AppraisalParameter[]
  peerNominations      PeerNomination[]
  hubEvents            HubEvent[]
  leaveTypes           LeaveType[]
  leaveBalances        LeaveBalance[]
  wfhPolicy            WfhPolicy?
  wfhBalances          WfhBalance[]
  leaveRequests        LeaveRequest[]
  leaveAuditLogs       LeaveAuditLog[]
  leaveAdjustments     LeaveBalanceAdjustment[]
  galleryPosts         GalleryPost[]
  departments          Department[]
  projects             Project[]
  projectContributions ProjectContribution[]
  entityAttachments    EntityAttachment[]
  trainingRecords      TrainingRecord[]
  achievements         Achievement[]
  incidents            Incident[]
  disputes             Dispute[]
  disputeMessages      DisputeMessage[]
  disputeSubjects      DisputeSubject[]
  oneOnOneMeetings     OneOnOneMeeting[]
  userCapabilities     UserCapability[]
  bloodGroups          BloodGroup[]
  goalOptions          GoalOption[]
  capabilityAuditLogs  CapabilityAuditLog[]
  cxoMessages          CxoMessage[]
  cxoMessageReplies    CxoMessageReply[]
  subscriptions        Subscription[]
  invoices             Invoice[]

  @@index([isPlatform])
  @@index([status])
  @@map("tenants")
}

/// What the platform operator did, as distinct from the five tenant-scoped
/// audit models which record what happens inside a company.
///
/// actorId is intentionally not a relation: an audit row must outlive the
/// operator account that created it, otherwise deleting a user erases the trail.
model PlatformAuditLog {
  id          String   @id @default(cuid())
  actorId     String
  action      String
  targetType  String
  targetId    String?
  tenantId    String?
  beforeValue Json?
  afterValue  Json?
  reason      String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  PROBATION
  INTERN
}

model TenantUser {
  id                 String     @id @default(cuid())
  tenantId           String
  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email              String     @unique
  passwordHash       String
  name               String
  role               UserRole   @default(EMPLOYEE)
  status             UserStatus @default(INVITED)
  /// Stamped on each successful login. Null means never recorded.
  lastLoginAt        DateTime?
  mustChangePassword Boolean    @default(true)

  // Employment Details
  empType          EmploymentType @default(PERMANENT)
  department       String?
  designation      String?
  band             String?
  officeLocation   String?
  managerId        String?
  manager          TenantUser?    @relation("ManagerSubordinates", fields: [managerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subordinates     TenantUser[]   @relation("ManagerSubordinates")
  joinDate         DateTime?
  confirmationDate DateTime?

  // Personal Info
  gender           String?
  dob              DateTime?
  bloodGroup       String?
  personalEmail    String?
  phone            String?
  emergencyContact String?

  // Statutory Docs
  pan     String?
  aadhaar String?
  uan     String?
  esic    String?

  // Smart HR Relations
  capabilities               UserCapability[]         @relation("UserCapabilities")
  cxoMessagesRaised          CxoMessage[]             @relation("CxoRaisedBy")
  cxoMessagesTargeted        CxoMessage[]             @relation("CxoTargetLeader")
  cxoMessagesAssigned        CxoMessage[]             @relation("CxoAssignee")
  cxoReplies                 CxoMessageReply[]        @relation("CxoReplyAuthor")
  capabilitiesGranted        UserCapability[]         @relation("CapabilityGrantedBy")
  capabilityAuditTarget      CapabilityAuditLog[]     @relation("CapabilityAuditTarget")
  capabilityAuditActor       CapabilityAuditLog[]     @relation("CapabilityAuditActor")
  bankDetails                BankDetails?
  workHistory                WorkHistory[]
  exitDetails                ExitDetails?
  goals                      Goal[]                   @relation("GoalAssignee")
  createdGoals               Goal[]                   @relation("GoalCreatedBy")
  goalAssignments            GoalAssignment[]         @relation("UserGoalAssignments")
  assignedGoalRecords        GoalAssignment[]         @relation("AssignedGoals")
  tasks                      Task[]
  leaveRequests              LeaveRequest[]           @relation("EmployeeLeaves")
  approvedLeaves             LeaveRequest[]           @relation("ApprovedLeaves")
  createdLeaveTypes          LeaveType[]              @relation("LeaveTypeCreator")
  updatedLeaveTypes          LeaveType[]              @relation("LeaveTypeUpdater")
  leaveBalances              LeaveBalance[]           @relation("EmployeeLeaveBalances")
  wfhBalances                WfhBalance[]             @relation("EmployeeWfhBalances")
  leaveAuditLogs             LeaveAuditLog[]          @relation("LeaveAuditActor")
  adjustedBalances           LeaveBalanceAdjustment[] @relation("BalanceAdjuster")
  balanceAdjustments         LeaveBalanceAdjustment[] @relation("BalanceAdjustmentEmployee")
  reviews                    PerformanceReview[]      @relation("EmployeeReviews")
  hrSignedOffReviews         PerformanceReview[]      @relation("HrSignoffActor")
  exReviews                  ExEmployerReview[]       @relation("EmployeeExReviews")
  nominatedReviewsAsReviewee PeerNomination[]         @relation("NominationReviewee")
  nominatedReviewsAsReviewer PeerNomination[]         @relation("NominationReviewer")
  createdAppraisalCycles     AppraisalCycle[]         @relation("CycleCreator")
  createdProjects            Project[]                @relation("ProjectCreatedBy")
  projectContributions       ProjectContribution[]    @relation("ProjectContributor")
  uploadedAttachments        EntityAttachment[]       @relation("EntityAttachmentUploader")
  trainingRecords            TrainingRecord[]         @relation("TrainingRecordEmployee")
  createdTrainingRecords     TrainingRecord[]         @relation("TrainingRecordCreator")
  achievements               Achievement[]            @relation("AchievementEmployee")
  loggedAchievements         Achievement[]            @relation("AchievementCreator")
  incidents                  Incident[]               @relation("IncidentEmployee")
  reportedIncidents          Incident[]               @relation("IncidentReporter")
  disputesRaised             Dispute[]                @relation("DisputeRaisedBy")
  disputeSubjectOf           Dispute[]                @relation("DisputeSubjectEmployee")
  disputeSubjectLinks        DisputeSubject[]         @relation("DisputeSubjectLink")
  oneOnOnesOrganised         OneOnOneMeeting[]        @relation("OneOnOneOrganiser")
  oneOnOnesAttending         OneOnOneMeeting[]        @relation("OneOnOneParticipant")
  disputesAssigned           Dispute[]                @relation("DisputeAssignee")
  disputeMessagesSent        DisputeMessage[]         @relation("DisputeMessageSender")
  // Policies & Compliance Relations
  createdPolicies            Policy[]                 @relation("PolicyAuthor")
  publishedPolicies          Policy[]                 @relation("PolicyPublisher")
  assignedPolicies           PolicyAssignment[]       @relation("PolicyAssigner")
  policyAssignments          PolicyAssignment[]       @relation("UserPolicyAssignments")
  policyAcceptances          PolicyAcceptance[]       @relation("UserPolicyAcceptances")
  policyAuditLogs            PolicyAuditLog[]         @relation("PolicyAuditActor")

  // Activity & Notifications
  taskComments        TaskComment[]        @relation("TaskCommentAuthor")
  taskAuditLogs       TaskAuditLog[]       @relation("TaskAuditPerformer")
  goalComments        GoalComment[]        @relation("GoalCommentAuthor")
  goalAuditLogs       GoalAuditLog[]       @relation("GoalAuditPerformer")
  notifications       Notification[]       @relation("UserNotifications")
  createdEvents       HubEvent[]           @relation("EventCreator")
  passwordResetTokens PasswordResetToken[]
  galleryPosts        GalleryPost[]        @relation("GalleryPostUploader")
  galleryLikes        GalleryLike[]        @relation("GalleryLikeUser")
  galleryComments     GalleryComment[]     @relation("GalleryCommentAuthor")

  remarks   String?
  docs      Json?
  isDeleted Boolean @default(false)

  // Company Hub Profile (employee-controlled social fields)
  hubBio       String?
  hubBirthday  String? // Display string e.g. "June 28" — separate from statutory dob
  profileSnaps Json? // Array of uploaded image URL strings

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("tenant_users")
}

model BankDetails {
  id            String     @id @default(cuid())
  userId        String     @unique
  user          TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName      String
  accountNumber String
  ifscCode      String
  branchName    String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("bank_details")
}

model WorkHistory {
  id             String     @id @default(cuid())
  userId         String
  user           TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String
  designation    String
  startDate      DateTime
  endDate        DateTime? // null = still employed there ("current")
  reasonForExit  String?
  verifiedStatus String     @default("PENDING") // PENDING | VERIFIED | REJECTED

  @@map("work_histories")
}

model ExitDetails {
  id              String     @id @default(cuid())
  userId          String     @unique
  user            TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  resignationDate DateTime
  lastWorkingDay  DateTime
  exitReason      String
  feedbackRemarks String?

  // Clearances
  itCleared        Boolean @default(false)
  hrCleared        Boolean @default(false)
  financeCleared   Boolean @default(false)
  settlementStatus String  @default("PENDING") // PENDING | COMPLETED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("exit_details")
}

enum RegistrationStatus {
  PENDING_FINANCE_REVIEW
  PENDING_CHEQUE_CONFIRMATION
  PENDING_HR_ACTIVATION
  ACTIVE
}

/// Extended, never reordered or replaced: ONLINE and CHEQUE keep their existing
/// meaning so no existing row changes. The rest describe how money actually
/// arrives now that the platform is a book of record rather than a till.
/// LEGACY marks pre-billing payments whose reference cannot be verified.
enum PaymentMethod {
  ONLINE
  CHEQUE
  BANK_TRANSFER
  UPI
  CASH
  ADJUSTMENT
  LEGACY
}

enum TokenRole {
  FINANCE
  HR
}

enum DiscountType {
  PERCENT
  FLAT
}

model CompanyRegistration {
  id String @id @default(cuid())

  // Level 1 — CMD/Director (MOU signup)
  companyName     String
  companyType     String
  domainName      String   @unique
  tenantCode      String   @unique
  fullName        String
  designation     String
  email           String   @unique
  passwordHash    String
  financeEmail    String
  hrEmail         String
  acceptedTermsAt DateTime

  // Level 2 — Finance
  gstin             String?
  licenseQuantity   Int?
  unitPrice         Decimal?       @db.Decimal(10, 2)
  couponId          String?
  coupon            Coupon?        @relation(fields: [couponId], references: [id])
  discountAmount    Decimal?       @db.Decimal(10, 2)
  subtotalAmount    Decimal?       @db.Decimal(10, 2)
  gstRate           Decimal?       @db.Decimal(5, 4)
  gstAmount         Decimal?       @db.Decimal(10, 2)
  totalAmount       Decimal?       @db.Decimal(10, 2)
  paymentMethod     PaymentMethod?
  paymentReference  String?
  chequeNumber      String?
  chequeDate        DateTime?
  transactionId     String?
  financeApprovedAt DateTime?

  // Level 3 — HR
  activatedAt DateTime?

  status RegistrationStatus @default(PENDING_FINANCE_REVIEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant?
  actionTokens     RegistrationActionToken[]
  verifications    RegistrationVerification[]
  notificationLogs NotificationLog[]

  @@index([status])
  @@map("company_registrations")
}

model EmailVerification {
  id                         String    @id @default(cuid())
  email                      String
  domainName                 String
  otpHash                    String
  otpExpiresAt               DateTime
  attempts                   Int       @default(0)
  verifiedAt                 DateTime?
  verificationToken          String?   @unique
  verificationTokenExpiresAt DateTime?
  consumedAt                 DateTime?
  createdAt                  DateTime  @default(now())

  @@index([email])
  @@map("email_verifications")
}

/// One row per verification decision on a company registration. History is
/// inherent to the shape: nothing is overwritten, and the newest row is the
/// current status.
///
/// reviewerId is not a relation — a decision must outlive the reviewer's
/// account, otherwise deleting a user erases the record.
model RegistrationVerification {
  id             String              @id @default(cuid())
  registrationId String
  registration   CompanyRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  status         VerificationStatus
  notes          String?             @db.Text
  reviewerId     String
  createdAt      DateTime            @default(now())

  @@index([registrationId, createdAt])
  @@map("registration_verifications")
}

model RegistrationActionToken {
  id             String              @id @default(cuid())
  registrationId String
  registration   CompanyRegistration @relation(fields: [registrationId], references: [id])
  role           TokenRole
  tokenHash      String              @unique
  expiresAt      DateTime
  lastUsedAt     DateTime?
  createdAt      DateTime            @default(now())

  @@index([registrationId, role])
  @@map("registration_action_tokens")
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  bdmName       String?
  expiresAt     DateTime?
  usageLimit    Int?
  timesUsed     Int          @default(0)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  registrations CompanyRegistration[]
  redemptions   CouponRedemption[]

  @@map("coupons")
}

// ═══════════════════════════════════════════════════════════════════════════
// BILLING
//
// The product sells TERM LICENCES: a package is price + seats + duration, and a
// purchase starts a term. Nothing recurs automatically — there is no scheduler
// and no stored payment mandate — so a renewal is an operator-approved repeat
// purchase rather than an automatic charge.
//
// The platform is the book of record, not the till. Money arrives by bank
// transfer, cheque or UPI and an operator records it against an invoice.
//
// Every money field on Invoice is a SNAPSHOT written once. Nothing is recomputed
// on read, so changing a package's price tomorrow cannot move an invoice issued
// today.
// ═══════════════════════════════════════════════════════════════════════════

enum BillingInterval {
  ONE_TIME
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum SubscriptionState {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum InvoiceState {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum RefundState {
  RECORDED
  REJECTED
}

/// A named, sellable thing. `unitPrice` is PER SEAT so lib/pricing.js is reused
/// unchanged for every quote, invoice and renewal.
model Package {
  id          String          @id @default(cuid())
  name        String
  description String?         @db.Text
  seatCount   Int
  interval    BillingInterval @default(ANNUAL)
  /// Null together with ONE_TIME means a perpetual licence.
  termMonths  Int?
  unitPrice   Decimal         @db.Decimal(10, 2)
  currency    String          @default("INR")
  active      Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  subscriptions Subscription[]

  @@index([active, sortOrder])
  @@map("packages")
}

/// One term. A renewal creates a NEW row pointing back at the old one, so the
/// history is a by-product of how it is stored rather than an audit afterthought.
model Subscription {
  id             String            @id @default(cuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  /// Nullable because a package may be retired while its sold terms live on.
  packageId      String?
  package        Package?          @relation(fields: [packageId], references: [id])
  /// Snapshots: what was sold, surviving a later rename or reprice.
  packageName    String
  seatCount      Int
  state          SubscriptionState @default(PENDING)
  startsAt       DateTime
  /// Null means perpetual.
  endsAt         DateTime?
  renewedFromId  String?           @unique
  renewedFrom    Subscription?     @relation("Renewal", fields: [renewedFromId], references: [id])
  renewedTo      Subscription?     @relation("Renewal")
  /// The original signup, for terms that came from the registration flow.
  registrationId String?
  cancelledAt    DateTime?
  cancelReason   String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  invoices Invoice[]

  @@index([tenantId, startsAt])
  @@index([state])
  @@index([endsAt])
  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(cuid())
  /// UEIBI/2026-27/0001 — sequential per Indian financial year, globally rather
  /// than per tenant, because a GST invoice series must be unbroken per issuer.
  /// @unique is what actually guarantees it under concurrency.
  ///
  /// Null until the invoice is ISSUED. A draft that is abandoned must not burn a
  /// number, because the gap it leaves in the series is exactly what an auditor
  /// asks about. Postgres allows many NULLs under a unique index, so drafts
  /// coexist freely and the number is allocated at the moment of issue.
  invoiceNumber  String?       @unique
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  /// Set on invoices backfilled from the pre-billing signup flow.
  registrationId String?
  state          InvoiceState  @default(DRAFT)

  /// Bill-to details are snapshots: a company renaming itself must not rewrite
  /// an invoice already issued to the old name.
  billToName  String
  billToGstin String?
  billToEmail String

  issuedAt DateTime?
  dueAt    DateTime?

  currency       String  @default("INR")
  quantity       Int
  unitPrice      Decimal @db.Decimal(10, 2)
  subtotalAmount Decimal @db.Decimal(10, 2)
  couponId       String?
  couponCode     String?
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  gstRate        Decimal @db.Decimal(5, 4)
  gstAmount      Decimal @db.Decimal(10, 2)
  totalAmount    Decimal @db.Decimal(10, 2)
  /// Derived from the Payment/Refund rows and kept in step inside the same
  /// transaction that writes them.
  amountPaid     Decimal @default(0) @db.Decimal(10, 2)
  amountRefunded Decimal @default(0) @db.Decimal(10, 2)

  notes      String?   @db.Text
  voidedAt   DateTime?
  voidReason String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  /// Which template version rendered this invoice. Null for invoices raised
  /// before templates existed; those fall back to the built-in layout.
  templateVersionId String?
  templateVersion   InvoiceTemplateVersion? @relation(fields: [templateVersionId], references: [id])

  payments    Payment[]
  refunds     Refund[]
  redemptions CouponRedemption[]

  @@index([tenantId, issuedAt])
  @@index([state])
  @@map("invoices")
}

/// Money actually received, however it arrived.
model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  tenantId  String
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  /// UTR, cheque number or gateway transaction id.
  reference String?
  receivedAt DateTime
  /// Not a relation, for the same reason PlatformAuditLog.actorId is not one:
  /// the record must outlive the operator's account.
  recordedById String
  notes        String?  @db.Text
  createdAt    DateTime @default(now())

  refunds Refund[]

  @@index([invoiceId])
  @@index([tenantId, receivedAt])
  @@index([method])
  @@map("payments")
}

/// Recorded, not executed — there is no gateway to call. The money is sent
/// separately and this is the note that it was.
model Refund {
  id           String        @id @default(cuid())
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  paymentId    String?
  payment      Payment?      @relation(fields: [paymentId], references: [id])
  tenantId     String
  amount       Decimal       @db.Decimal(10, 2)
  /// Always required. An unexplained refund is useless six months later.
  reason       String        @db.Text
  method       PaymentMethod
  reference    String?
  state        RefundState   @default(RECORDED)
  refundedAt   DateTime
  recordedById String
  createdAt    DateTime      @default(now())

  @@index([invoiceId])
  @@index([tenantId, refundedAt])
  @@map("refunds")
}

/// Coupon.timesUsed is a counter that cannot be reported on. This makes each
/// redemption a row, so "which coupon earned what" becomes answerable.
model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  coupon         Coupon   @relation(fields: [couponId], references: [id])
  invoiceId      String?
  invoice        Invoice? @relation(fields: [invoiceId], references: [id])
  tenantId       String?
  registrationId String?
  discountAmount Decimal  @db.Decimal(10, 2)
  redeemedAt     DateTime @default(now())

  @@index([couponId, redeemedAt])
  @@map("coupon_redemptions")
}

model NotificationLog {
  id                String               @id @default(cuid())
  registrationId    String?
  registration      CompanyRegistration? @relation(fields: [registrationId], references: [id])
  event             String
  recipient         String
  subject           String
  bodyText          String               @db.Text
  status            String
  providerMessageId String?
  error             String?              @db.Text
  createdAt         DateTime             @default(now())

  @@index([registrationId])
  @@index([event])
  @@map("notification_logs")
}

model Goal {
  id                  String           @id @default(cuid())
  tenantId            String
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title               String
  description         String?          @db.Text
  goalType            String?          @default("General") // General | Private
  category            String?
  priority            String? // low | medium | high | critical
  createdBy           String? // Legacy: creator name string (kept for backward compat)
  createdById         String? // FK to TenantUser who created this goal (null = legacy record)
  createdByUser       TenantUser?      @relation("GoalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvalMode        String? // MANAGER_APPROVAL | AUTO_APPROVE | null (null = employee self-created)
  progress            Int              @default(0)
  status              String           @default("DRAFT") // DRAFT | PENDING_APPROVAL | ACTIVE | PENDING_MANAGER_REVIEW | PENDING_HR_REVIEW | CHANGES_REQUESTED | COMPLETED
  financialYear       String?
  quarter             String?
  startDate           DateTime?
  targetDate          DateTime?
  attachments         String[]
  specialNotes        String?          @db.Text
  dueDate             DateTime?
  employeeId          String?
  employee            TenantUser?      @relation("GoalAssignee", fields: [employeeId], references: [id], onDelete: Cascade)
  milestones          Int              @default(0)
  completedMilestones Int              @default(0)
  /// Goals whose work had already begun when task weighting was introduced.
  /// They keep the old behaviour; the 100% rule applies to everything else.
  weightLockExempt    Boolean          @default(false)
  tasks               Task[]
  comments            GoalComment[]
  auditLogs           GoalAuditLog[]
  assignments         GoalAssignment[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([createdById])
  @@map("goals")
}

model GoalAssignment {
  id                  String      @id @default(cuid())
  tenantId            String
  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  goalId              String
  goal                Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            TenantUser  @relation("UserGoalAssignments", fields: [employeeId], references: [id], onDelete: Cascade)
  assignedById        String?
  assignedBy          TenantUser? @relation("AssignedGoals", fields: [assignedById], references: [id], onDelete: SetNull)
  progress            Int         @default(0)
  status              String      @default("DRAFT") // DRAFT | ASSIGNED | ACKNOWLEDGED | IN_PROGRESS | UNDER_REVIEW | COMPLETED
  milestones          Int         @default(0)
  completedMilestones Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([goalId, employeeId])
  @@index([tenantId])
  @@index([goalId])
  @@index([employeeId])
  @@index([assignedById])
  @@map("goal_assignments")
}

model Task {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title          String
  priority       String? // high | critical | medium | low
  status         String         @default("todo") // todo | in_progress | pending_on_others | in_review | done | pending_approval | rejected  (see src/lib/workflowStatus.js)
  progress       Int            @default(0)
  startDate      DateTime?
  dueDate        DateTime?
  financialYear  String? // e.g. "FY 2026-27"
  tags           String? // comma-separated tags
  goalId         String?
  goal           Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  isPrivate      Boolean        @default(false)
  isStandalone   Boolean        @default(false)
  /// Percentage share of the parent goal. A goal's tasks must total exactly
  /// 100 before its execution unlocks (see services/goalWeight.service.js).
  weight         Int            @default(1)
  /// When work actually began / actually finished, against the planned
  /// startDate / dueDate above. Null on tasks that predate this column.
  actualStartDate      DateTime?
  actualCompletionDate DateTime?
  employeeId     String
  employee       TenantUser     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  description    String?        @db.Text
  dependency     Json? // serialised dep object: { assigneeId, depTitle, status, escalated, depTaskId }
  isDependencyOf String? // parent task ID this task is a companion dep of
  comments       TaskComment[]
  auditLogs      TaskAuditLog[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([goalId])
  @@map("tasks")
}

// ── Task Activity ──────────────────────────────────────────────────────────

model TaskComment {
  id          String     @id @default(cuid())
  taskId      String
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId    String
  author      TenantUser @relation("TaskCommentAuthor", fields: [authorId], references: [id])
  comment     String     @db.Text
  attachments String[] // stored file paths / rich JSON metadata
