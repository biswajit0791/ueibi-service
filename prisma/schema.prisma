  @@map("goal_comments")
}

model GoalAuditLog {
  id            String     @id @default(cuid())
  goalId        String
  goal          Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  performedById String
  performedBy   TenantUser @relation("GoalAuditPerformer", fields: [performedById], references: [id])
  action        String // GOAL_CREATED | GOAL_UPDATED | GOAL_SUBMITTED | GOAL_RESUBMITTED | MANAGER_APPROVED | CHANGES_REQUESTED | HR_APPROVED | HR_CHANGES_REQUESTED | progress_update
  details       String?    @db.Text
  previousValue Json?
  createdAt     DateTime   @default(now())

  @@index([goalId])
  @@map("goal_audit_logs")
