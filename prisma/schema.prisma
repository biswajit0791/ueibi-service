  name           String
  source         String      @default("SELF_SUBMITTED") // SELF_SUBMITTED | COMPANY_MANDATED
  mandatedBy     String?
  status         String      @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  approvalStatus String      @default("PENDING") // PENDING | APPROVED | REJECTED
  score          String?
  durationHours  Int?
  startedAt      DateTime?
  completedAt    DateTime?
  financialYear  String?
  createdById    String?
  createdBy      TenantUser? @relation("TrainingRecordCreator", fields: [createdById], references: [id], onDelete: SetNull)
