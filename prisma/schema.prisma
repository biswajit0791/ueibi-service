  body        String?    @db.Text
  entityType  String? // task | goal | appraisal
  entityId    String?
  isRead      Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@index([recipientId, isRead])
  @@index([tenantId])
  @@map("notifications")
}

model LeaveRequest {
  id                     String          @id @default(cuid())
  tenantId               String?
  tenant                 Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId             String
  employee               TenantUser      @relation("EmployeeLeaves", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId            String?
  leaveType              LeaveType?      @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)
  type                   String // Legacy field: 'Casual Leave' | 'Sick Leave' | 'Annual Leave' | 'WFH'
  requestType            String          @default("LEAVE") // 'LEAVE' | 'WFH'
  startDate              DateTime
  endDate                DateTime
  totalDays              Float           @default(1)
  dayType                String          @default("FULL") // 'FULL' | 'FIRST_HALF' | 'SECOND_HALF'
  reason                 String?         @db.Text
  attachmentUrl          String?
  attachmentOriginalName String?
  status                 String          @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  managerStatus          String          @default("Pending") // Pending | Approved | Rejected | Not Required
  managerId              String?
  managerComment         String?         @db.Text
  managerActedAt         DateTime?
  hrStatus               String          @default("Pending") // Pending | Approved | Rejected | Not Required
  hrId                   String?
  hrComment              String?         @db.Text
  hrActedAt              DateTime?
