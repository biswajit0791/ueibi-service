  @@index([taskId])
  @@map("task_comments")
}

model TaskAuditLog {
  id            String     @id @default(cuid())
  taskId        String
  task          Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  performedById String
  performedBy   TenantUser @relation("TaskAuditPerformer", fields: [performedById], references: [id])
  action        String // created | status_changed | edited | progress_update | dependency_created | escalated | approved | deleted
  details       String?    @db.Text
  previousValue Json?
  createdAt     DateTime   @default(now())

  @@index([taskId])
  @@map("task_audit_logs")
}

// ── Goal Activity ──────────────────────────────────────────────────────────

model GoalComment {
