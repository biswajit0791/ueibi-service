// ── Dispute Center (support tickets) ──────────────────────────────────────
model Dispute {
  id           String @id @default(cuid())
  tenantId     String
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketNumber String @unique

  subject     String
  description String @db.Text
  category    String @default("Review Dispute")
  priority    String @default("MEDIUM") // LOW | MEDIUM | HIGH
  status      String @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED

  raisedById String
  raisedBy   TenantUser @relation("DisputeRaisedBy", fields: [raisedById], references: [id], onDelete: Cascade)

  subjectEmployeeId String?
  subjectEmployee   TenantUser? @relation("DisputeSubjectEmployee", fields: [subjectEmployeeId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   TenantUser? @relation("DisputeAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  resolvedAt      DateTime?
  resolutionNotes String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages DisputeMessage[]

  // Every employee this ticket is about. `subjectEmployeeId` above remains the
  // primary subject so existing queries, filters and notifications are
  // unaffected; this table carries the full set when one issue covers several
  // people. The primary subject also has a row here, so reads need only one
  // source of truth.
  subjects DisputeSubject[]

  @@index([tenantId, status])
  @@index([raisedById])
  @@index([subjectEmployeeId])
  @@map("disputes")
}

model DisputeSubject {
  id         String     @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  disputeId  String
  dispute    Dispute    @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  employeeId String
  employee   TenantUser @relation("DisputeSubjectLink", fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())

  @@unique([disputeId, employeeId])
  @@index([tenantId])
  @@index([disputeId])
  @@index([employeeId])
  @@map("dispute_subjects")
}

model DisputeMessage {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  disputeId String
  dispute   Dispute    @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  senderId  String
  sender    TenantUser @relation("DisputeMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body      String     @db.Text
  createdAt DateTime   @default(now())

  @@index([disputeId])
  @@map("dispute_messages")
}

model PeerNomination {
  id         String           @id @default(cuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycleId    String
  cycle      AppraisalCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  revieweeId String
