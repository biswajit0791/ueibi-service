  date        String
  time        String?
  location    String?
  description String     @db.Text
  isFeatured  Boolean    @default(true)
  createdById String
  createdBy   TenantUser @relation("EventCreator", fields: [createdById], references: [id], onDelete: Cascade)
  postedBy    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([tenantId])
  @@index([createdById])
  @@map("hub_events")
}

model PasswordResetToken {
  id        String     @id @default(cuid())
  userId    String
  user      TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String     @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ── Corporate Gallery ───────────────────────────────────────────────────────

model GalleryPost {
