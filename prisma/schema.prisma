// ── Training/Certifications, Achievements & Incidents Journal, Attachments ───
enum AttachmentEntityType {
  TRAINING_RECORD
  ACHIEVEMENT
  INCIDENT
  DISPUTE
}

model EntityAttachment {
  id           String               @id @default(cuid())
  tenantId     String
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType   AttachmentEntityType
  entityId     String
  uploadedById String
  uploadedBy   TenantUser           @relation("EntityAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
