generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CMD
  HR
  FINANCE
  MANAGER
  EMPLOYEE
  STUDENT
  MENTOR
}

enum UserStatus {
  INVITED
  ACTIVE
  EXITED
}

model Tenant {
  id                  String                   @id @default(cuid())
  companyName         String
  domainName          String                   @unique
  tenantCode          String                   @unique
  licenseLimit        Int                      @default(0)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  users               TenantUser[]
  registrationId      String?                  @unique
  registration        CompanyRegistration?     @relation(fields: [registrationId], references: [id])
  exEmployeeRecords   ExEmployeeRecord[]
  nonJoinerRecords    NonJoinerRecord[]
  notifications       Notification[]
  goals               Goal[]
  goalAssignments     GoalAssignment[]
  tasks               Task[]
  policies            Policy[]
  policyAssignments   PolicyAssignment[]
  policyAcceptances   PolicyAcceptance[]
  policyAuditLogs     PolicyAuditLog[]
  appraisalCycles     AppraisalCycle[]
  appraisalParameters AppraisalParameter[]
  peerNominations     PeerNomination[]
  hubEvents           HubEvent[]
  leaveTypes          LeaveType[]
  leaveBalances       LeaveBalance[]
  wfhPolicy           WfhPolicy?
  wfhBalances         WfhBalance[]
  leaveRequests       LeaveRequest[]
  leaveAuditLogs      LeaveAuditLog[]
  leaveAdjustments    LeaveBalanceAdjustment[]
  galleryPosts        GalleryPost[]
  departments         Department[]

  @@map("tenants")
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  PROBATION
  INTERN
}

model TenantUser {
  id                 String     @id @default(cuid())
  tenantId           String
  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email              String     @unique
  passwordHash       String
  name               String
  role               UserRole   @default(EMPLOYEE)
  status             UserStatus @default(INVITED)
  mustChangePassword Boolean    @default(true)

  // Employment Details
  empType          EmploymentType @default(PERMANENT)
  department       String?
  designation      String?
  band             String?
  officeLocation   String?
  managerId        String?
  manager          TenantUser?    @relation("ManagerSubordinates", fields: [managerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subordinates     TenantUser[]   @relation("ManagerSubordinates")
  joinDate         DateTime?
  confirmationDate DateTime?

  // Personal Info
  gender           String?
  dob              DateTime?
  bloodGroup       String?
  personalEmail    String?
  phone            String?
  emergencyContact String?

  // Statutory Docs
  pan     String?
  aadhaar String?
  uan     String?
  esic    String?

  // Smart HR Relations
  bankDetails                BankDetails?
  workHistory                WorkHistory[]
  exitDetails                ExitDetails?
  goals                      Goal[]                   @relation("GoalAssignee")
  createdGoals               Goal[]                   @relation("GoalCreatedBy")
  goalAssignments            GoalAssignment[]         @relation("UserGoalAssignments")
  assignedGoalRecords        GoalAssignment[]         @relation("AssignedGoals")
  tasks                      Task[]
  leaveRequests              LeaveRequest[]           @relation("EmployeeLeaves")
  approvedLeaves             LeaveRequest[]           @relation("ApprovedLeaves")
  createdLeaveTypes          LeaveType[]              @relation("LeaveTypeCreator")
  updatedLeaveTypes          LeaveType[]              @relation("LeaveTypeUpdater")
  leaveBalances              LeaveBalance[]           @relation("EmployeeLeaveBalances")
  wfhBalances                WfhBalance[]             @relation("EmployeeWfhBalances")
  leaveAuditLogs             LeaveAuditLog[]          @relation("LeaveAuditActor")
  adjustedBalances           LeaveBalanceAdjustment[] @relation("BalanceAdjuster")
  balanceAdjustments         LeaveBalanceAdjustment[] @relation("BalanceAdjustmentEmployee")
  reviews                    PerformanceReview[]      @relation("EmployeeReviews")
  hrSignedOffReviews         PerformanceReview[]      @relation("HrSignoffActor")
  exReviews                  ExEmployerReview[]       @relation("EmployeeExReviews")
  nominatedReviewsAsReviewee PeerNomination[]         @relation("NominationReviewee")
  nominatedReviewsAsReviewer PeerNomination[]         @relation("NominationReviewer")
  createdAppraisalCycles     AppraisalCycle[]         @relation("CycleCreator")
  // Policies & Compliance Relations
  createdPolicies            Policy[]                 @relation("PolicyAuthor")
  publishedPolicies          Policy[]                 @relation("PolicyPublisher")
  assignedPolicies           PolicyAssignment[]       @relation("PolicyAssigner")
  policyAssignments          PolicyAssignment[]       @relation("UserPolicyAssignments")
  policyAcceptances          PolicyAcceptance[]       @relation("UserPolicyAcceptances")
  policyAuditLogs            PolicyAuditLog[]         @relation("PolicyAuditActor")

  // Activity & Notifications
  taskComments        TaskComment[]        @relation("TaskCommentAuthor")
  taskAuditLogs       TaskAuditLog[]       @relation("TaskAuditPerformer")
  goalComments        GoalComment[]        @relation("GoalCommentAuthor")
  goalAuditLogs       GoalAuditLog[]       @relation("GoalAuditPerformer")
  notifications       Notification[]       @relation("UserNotifications")
  createdEvents       HubEvent[]           @relation("EventCreator")
  passwordResetTokens PasswordResetToken[]
  galleryPosts   GalleryPost[]       @relation("GalleryPostUploader")
  galleryLikes   GalleryLike[]       @relation("GalleryLikeUser")
  galleryComments GalleryComment[]   @relation("GalleryCommentAuthor")

  remarks   String?
  docs      Json?
  isDeleted Boolean @default(false)

  // Company Hub Profile (employee-controlled social fields)
  hubBio       String?
  hubBirthday  String? // Display string e.g. "June 28" — separate from statutory dob
  profileSnaps Json? // Array of uploaded image URL strings

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("tenant_users")
}

model BankDetails {
  id            String     @id @default(cuid())
  userId        String     @unique
  user          TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName      String
  accountNumber String
  ifscCode      String
  branchName    String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("bank_details")
}

model WorkHistory {
  id             String     @id @default(cuid())
  userId         String
  user           TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String
  designation    String
  startDate      DateTime
  endDate        DateTime? // null = still employed there ("current")
  reasonForExit  String?
  verifiedStatus String     @default("PENDING") // PENDING | VERIFIED | REJECTED

  @@map("work_histories")
}

model ExitDetails {
  id              String     @id @default(cuid())
  userId          String     @unique
  user            TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  resignationDate DateTime
  lastWorkingDay  DateTime
  exitReason      String
  feedbackRemarks String?

  // Clearances
  itCleared        Boolean @default(false)
  hrCleared        Boolean @default(false)
  financeCleared   Boolean @default(false)
  settlementStatus String  @default("PENDING") // PENDING | COMPLETED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("exit_details")
}

enum RegistrationStatus {
  PENDING_FINANCE_REVIEW
  PENDING_CHEQUE_CONFIRMATION
  PENDING_HR_ACTIVATION
  ACTIVE
}

enum PaymentMethod {
  ONLINE
  CHEQUE
}

enum TokenRole {
  FINANCE
  HR
}

enum DiscountType {
  PERCENT
  FLAT
}

model CompanyRegistration {
  id String @id @default(cuid())

  // Level 1 — CMD/Director (MOU signup)
  companyName     String
  companyType     String
  domainName      String   @unique
  tenantCode      String   @unique
  fullName        String
  designation     String
  email           String   @unique
  passwordHash    String
  financeEmail    String
  hrEmail         String
  acceptedTermsAt DateTime

  // Level 2 — Finance
  gstin             String?
  licenseQuantity   Int?
  unitPrice         Decimal?       @db.Decimal(10, 2)
  couponId          String?
  coupon            Coupon?        @relation(fields: [couponId], references: [id])
  discountAmount    Decimal?       @db.Decimal(10, 2)
  subtotalAmount    Decimal?       @db.Decimal(10, 2)
  gstRate           Decimal?       @db.Decimal(5, 4)
  gstAmount         Decimal?       @db.Decimal(10, 2)
  totalAmount       Decimal?       @db.Decimal(10, 2)
  paymentMethod     PaymentMethod?
  paymentReference  String?
  chequeNumber      String?
  chequeDate        DateTime?
  transactionId     String?
  financeApprovedAt DateTime?

  // Level 3 — HR
  activatedAt DateTime?

  status RegistrationStatus @default(PENDING_FINANCE_REVIEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant?
  actionTokens     RegistrationActionToken[]
  notificationLogs NotificationLog[]

  @@index([status])
  @@map("company_registrations")
}

model EmailVerification {
  id                         String    @id @default(cuid())
  email                      String
  domainName                 String
  otpHash                    String
  otpExpiresAt               DateTime
  attempts                   Int       @default(0)
  verifiedAt                 DateTime?
  verificationToken          String?   @unique
  verificationTokenExpiresAt DateTime?
  consumedAt                 DateTime?
  createdAt                  DateTime  @default(now())

  @@index([email])
  @@map("email_verifications")
}

model RegistrationActionToken {
  id             String              @id @default(cuid())
  registrationId String
  registration   CompanyRegistration @relation(fields: [registrationId], references: [id])
  role           TokenRole
  tokenHash      String              @unique
  expiresAt      DateTime
  lastUsedAt     DateTime?
  createdAt      DateTime            @default(now())

  @@index([registrationId, role])
  @@map("registration_action_tokens")
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  bdmName       String?
  expiresAt     DateTime?
  usageLimit    Int?
  timesUsed     Int          @default(0)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  registrations CompanyRegistration[]

  @@map("coupons")
}

model NotificationLog {
  id                String               @id @default(cuid())
  registrationId    String?
  registration      CompanyRegistration? @relation(fields: [registrationId], references: [id])
  event             String
  recipient         String
  subject           String
  bodyText          String               @db.Text
  status            String
  providerMessageId String?
  error             String?              @db.Text
  createdAt         DateTime             @default(now())

  @@index([registrationId])
  @@index([event])
  @@map("notification_logs")
}

model Goal {
  id                  String           @id @default(cuid())
  tenantId            String
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title               String
  description         String?          @db.Text
  goalType            String?          @default("General") // General | Private
  category            String?
  priority            String? // low | medium | high | critical
  createdBy           String?        // Legacy: creator name string (kept for backward compat)
  createdById         String?        // FK to TenantUser who created this goal (null = legacy record)
  createdByUser       TenantUser?    @relation("GoalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvalMode        String?        // MANAGER_APPROVAL | AUTO_APPROVE | null (null = employee self-created)
  progress            Int            @default(0)
  status              String         @default("DRAFT") // DRAFT | PENDING_APPROVAL | ACTIVE | PENDING_MANAGER_REVIEW | PENDING_HR_REVIEW | CHANGES_REQUESTED | COMPLETED
  financialYear       String?
  quarter             String?
  startDate           DateTime?
  targetDate          DateTime?
  attachments         String[]
  specialNotes        String?          @db.Text
  dueDate             DateTime?
  employeeId          String?
  employee            TenantUser?    @relation("GoalAssignee", fields: [employeeId], references: [id], onDelete: Cascade)
  milestones          Int            @default(0)
  completedMilestones Int            @default(0)
  tasks               Task[]
  comments            GoalComment[]
  auditLogs           GoalAuditLog[]
  assignments         GoalAssignment[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([createdById])
  @@map("goals")
}

model GoalAssignment {
  id                  String      @id @default(cuid())
  tenantId            String
  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  goalId              String
  goal                Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            TenantUser  @relation("UserGoalAssignments", fields: [employeeId], references: [id], onDelete: Cascade)
  assignedById        String?
  assignedBy          TenantUser? @relation("AssignedGoals", fields: [assignedById], references: [id], onDelete: SetNull)
  progress            Int         @default(0)
  status              String      @default("DRAFT") // DRAFT | ASSIGNED | ACKNOWLEDGED | IN_PROGRESS | UNDER_REVIEW | COMPLETED
  milestones          Int         @default(0)
  completedMilestones Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([goalId, employeeId])
  @@index([tenantId])
  @@index([goalId])
  @@index([employeeId])
  @@index([assignedById])
  @@map("goal_assignments")
}

model Task {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title          String
  priority       String? // high | critical | medium | low
  status         String         @default("todo") // todo | in_progress | pending_on_others | in_review | done | pending_approval | rejected  (see src/lib/workflowStatus.js)
  progress       Int            @default(0)
  startDate      DateTime?
  dueDate        DateTime?
  financialYear  String? // e.g. "FY 2026-27"
  tags           String? // comma-separated tags
  goalId         String?
  goal           Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  isPrivate      Boolean        @default(false)
  isStandalone   Boolean        @default(false)
  weight         Int            @default(1)
  employeeId     String
  employee       TenantUser     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  description    String?        @db.Text
  dependency     Json? // serialised dep object: { assigneeId, depTitle, status, escalated, depTaskId }
  isDependencyOf String? // parent task ID this task is a companion dep of
  comments       TaskComment[]
  auditLogs      TaskAuditLog[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([goalId])
  @@map("tasks")
}

// ── Task Activity ──────────────────────────────────────────────────────────

model TaskComment {
  id          String     @id @default(cuid())
  taskId      String
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId    String
  author      TenantUser @relation("TaskCommentAuthor", fields: [authorId], references: [id])
  comment     String     @db.Text
  attachments String[] // stored file paths / rich JSON metadata
  createdAt   DateTime   @default(now())

  @@index([taskId])
  @@map("task_comments")
}

model TaskAuditLog {
  id            String     @id @default(cuid())
  taskId        String
  task          Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  performedById String
  performedBy   TenantUser @relation("TaskAuditPerformer", fields: [performedById], references: [id])
  action        String // created | status_changed | edited | progress_update | dependency_created | escalated | approved | deleted
  details       String?    @db.Text
  previousValue Json?
  createdAt     DateTime   @default(now())

  @@index([taskId])
  @@map("task_audit_logs")
}

// ── Goal Activity ──────────────────────────────────────────────────────────

model GoalComment {
  id          String     @id @default(cuid())
  goalId      String
  goal        Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  authorId    String
  author      TenantUser @relation("GoalCommentAuthor", fields: [authorId], references: [id])
  comment     String     @db.Text
  attachments String[]
  createdAt   DateTime   @default(now())

  @@index([goalId])
  @@map("goal_comments")
}

model GoalAuditLog {
  id            String     @id @default(cuid())
  goalId        String
  goal          Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  performedById String
  performedBy   TenantUser @relation("GoalAuditPerformer", fields: [performedById], references: [id])
  action        String // GOAL_CREATED | GOAL_UPDATED | GOAL_SUBMITTED | GOAL_RESUBMITTED | MANAGER_APPROVED | CHANGES_REQUESTED | HR_APPROVED | HR_CHANGES_REQUESTED | progress_update
  details       String?    @db.Text
  previousValue Json?
  createdAt     DateTime   @default(now())

  @@index([goalId])
  @@map("goal_audit_logs")
}

// ── Notifications ──────────────────────────────────────────────────────────

model Notification {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   TenantUser @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  type        String // task_update | dep_approved | goal_update | appraisal | leave
  title       String
  body        String?    @db.Text
  entityType  String? // task | goal | appraisal
  entityId    String?
  isRead      Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@index([recipientId, isRead])
  @@index([tenantId])
  @@map("notifications")
}

model LeaveRequest {
  id                     String          @id @default(cuid())
  tenantId               String?
  tenant                 Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId             String
  employee               TenantUser      @relation("EmployeeLeaves", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId            String?
  leaveType              LeaveType?      @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)
  type                   String // Legacy field: 'Casual Leave' | 'Sick Leave' | 'Annual Leave' | 'WFH'
  requestType            String          @default("LEAVE") // 'LEAVE' | 'WFH'
  startDate              DateTime
  endDate                DateTime
  totalDays              Float           @default(1)
  dayType                String          @default("FULL") // 'FULL' | 'FIRST_HALF' | 'SECOND_HALF'
  reason                 String?         @db.Text
  attachmentUrl          String?
  attachmentOriginalName String?
  status                 String          @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  managerStatus          String          @default("Pending") // Pending | Approved | Rejected | Not Required
  managerId              String?
  managerComment         String?         @db.Text
  managerActedAt         DateTime?
  hrStatus               String          @default("Pending") // Pending | Approved | Rejected | Not Required
  hrId                   String?
  hrComment              String?         @db.Text
  hrActedAt              DateTime?
  approvedById           String?
  approvedBy             TenantUser?     @relation("ApprovedLeaves", fields: [approvedById], references: [id])
  rejectedById           String?
  rejectedAt             DateTime?
  rejectionReason        String?         @db.Text
  cancelledById          String?
  cancelledAt            DateTime?
  auditLogs              LeaveAuditLog[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([tenantId])
  @@index([employeeId, status])
  @@index([leaveTypeId])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

model LeaveType {
  id                        String                   @id @default(cuid())
  tenantId                  String
  tenant                    Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                      String
  code                      String
  description               String?                  @db.Text
  defaultDays               Float                    @default(0)
  allocationType            String                   @default("ANNUAL") // ANNUAL | MONTHLY | ACCRUAL | LUMP_SUM
  year                      Int?
  isPaid                    Boolean                  @default(true)
  requiresApproval          Boolean                  @default(true)
  allowHalfDay              Boolean                  @default(true)
  allowNegativeBalance      Boolean                  @default(false)
  maxConsecutiveDays        Int?
  minNoticeDays             Int                      @default(0)
  carryForwardAllowed       Boolean                  @default(false)
  maxCarryForwardDays       Int                      @default(0)
  encashmentAllowed         Boolean                  @default(false)
  requiresDocument          Boolean                  @default(false)
  documentRequiredAfterDays Int                      @default(2)
  isActive                  Boolean                  @default(true)
  createdById               String?
  createdBy                 TenantUser?              @relation("LeaveTypeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById               String?
  updatedBy                 TenantUser?              @relation("LeaveTypeUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  leaveRequests             LeaveRequest[]
  balances                  LeaveBalance[]
  adjustments               LeaveBalanceAdjustment[]
  auditLogs                 LeaveAuditLog[]
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("leave_types")
}

model LeaveBalance {
  id             String     @id @default(cuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       TenantUser @relation("EmployeeLeaveBalances", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId    String
  leaveType      LeaveType  @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year           Int
  allocated      Float      @default(0)
  carriedForward Float      @default(0)
  adjusted       Float      @default(0)
  used           Float      @default(0)
  pending        Float      @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([tenantId, employeeId, leaveTypeId, year])
  @@index([tenantId, employeeId, year])
  @@map("leave_balances")
}

model WfhPolicy {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isEnabled          Boolean  @default(true)
  annualDays         Float    @default(15)
  requiresApproval   Boolean  @default(true)
  maxConsecutiveDays Int?     @default(5)
  minNoticeDays      Int      @default(0)
  monthlyLimit       Int?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("wfh_policies")
}

model WfhBalance {
  id         String     @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   TenantUser @relation("EmployeeWfhBalances", fields: [employeeId], references: [id], onDelete: Cascade)
  year       Int
  allocated  Float      @default(15)
  adjusted   Float      @default(0)
  used       Float      @default(0)
  pending    Float      @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([tenantId, employeeId, year])
  @@index([tenantId, employeeId, year])
  @@map("wfh_balances")
}

model LeaveAuditLog {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveTypeId    String?
  leaveType      LeaveType?    @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)
  leaveRequestId String?
  leaveRequest   LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)
  actorUserId    String
  actor          TenantUser    @relation("LeaveAuditActor", fields: [actorUserId], references: [id])
  action         String // LEAVE_TYPE_CREATED | LEAVE_TYPE_UPDATED | LEAVE_TYPE_ACTIVATED | LEAVE_TYPE_DEACTIVATED | LEAVE_TYPE_DELETED | LEAVE_REQUEST_CREATED | LEAVE_REQUEST_APPROVED | LEAVE_REQUEST_REJECTED | LEAVE_REQUEST_CANCELLED | WFH_REQUEST_CREATED | WFH_REQUEST_APPROVED | WFH_REQUEST_REJECTED | WFH_REQUEST_CANCELLED | BALANCE_ADJUSTED | POLICY_UPDATED
  details        String?       @db.Text
  ipAddress      String?
  userAgent      String?       @db.Text
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([tenantId])
  @@index([action])
  @@map("leave_audit_logs")
}

model LeaveBalanceAdjustment {
  id               String     @id @default(cuid())
  tenantId         String
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         TenantUser @relation("BalanceAdjustmentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId      String?
  leaveType        LeaveType? @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)
  isWfh            Boolean    @default(false)
  year             Int
  previousBalance  Float
  newBalance       Float
  adjustmentAmount Float
  reason           String     @db.Text
  adjustedById     String
  adjustedBy       TenantUser @relation("BalanceAdjuster", fields: [adjustedById], references: [id])
  createdAt        DateTime   @default(now())

  @@index([tenantId])
  @@index([employeeId])
  @@map("leave_balance_adjustments")
}

enum AppraisalFrequency {
  ANNUAL
  QUARTERLY
  MONTHLY
}

enum AppraisalCycleStatus {
  ACTIVE
  CLOSED
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
  MANAGER_REVIEWED
  COMPLETED
}

enum HrSignoffStatus {
  PENDING_RELEASE
  RELEASED
}

enum NominationStatus {
  PENDING
  COMPLETED
  REJECTED
}

model AppraisalCycle {
  id          String               @id @default(cuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  frequency   AppraisalFrequency   @default(ANNUAL)
  year        Int?
  month       String?
  monthNumber Int?
  createdById String?
  createdBy   TenantUser?          @relation("CycleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  startDate   DateTime
  endDate     DateTime
  status      AppraisalCycleStatus @default(ACTIVE)
  parameters  AppraisalParameter[]
  reviews     PerformanceReview[]
  nominations PeerNomination[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([tenantId, frequency, name])
  @@index([tenantId])
  @@index([tenantId, year, month])
  @@map("appraisal_cycles")
}

model AppraisalParameter {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycleId   String
  cycle     AppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  name      String
  order     Int            @default(1)
  isActive  Boolean        @default(true)
  scores    ReviewScore[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([tenantId])
  @@index([cycleId])
  @@map("appraisal_parameters")
}

model PerformanceReview {
  id                  String             @id @default(cuid())
  cycleId             String
  cycle               AppraisalCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            TenantUser         @relation("EmployeeReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewType          AppraisalFrequency @default(ANNUAL)
  dueDate             DateTime?
  status              ReviewStatus       @default(DRAFT)
  selfAccomplishments String?            @db.Text
  selfWeaknesses      String?            @db.Text
  selfRating          Decimal?           @db.Decimal(3, 2)
  selfSubmittedAt     DateTime?
  managerRemarks      String?            @db.Text
  managerRating       Decimal?           @db.Decimal(3, 2)
  managerSubmittedAt  DateTime?
  hikePercentage      Decimal?           @db.Decimal(5, 2)
  hrSignoffStatus     HrSignoffStatus    @default(PENDING_RELEASE)
  hrRemarks           String?            @db.Text
  hrSignedOffById     String?
  hrSignedOffBy       TenantUser?        @relation("HrSignoffActor", fields: [hrSignedOffById], references: [id])
  hrSignedOffAt       DateTime?
  scores              ReviewScore[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([cycleId, employeeId, reviewType])
  @@index([employeeId])
  @@index([cycleId])
  @@map("performance_reviews")
}

model ReviewScore {
  id           String             @id @default(cuid())
  reviewId     String
  review       PerformanceReview  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  parameterId  String
  parameter    AppraisalParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  selfScore    Int?
  managerScore Int?
  hrScore      Int?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([reviewId, parameterId])
  @@index([reviewId])
  @@index([parameterId])
  @@map("review_scores")
}

model PeerNomination {
  id         String           @id @default(cuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycleId    String
  cycle      AppraisalCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  revieweeId String
  reviewee   TenantUser       @relation("NominationReviewee", fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   TenantUser       @relation("NominationReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  status     NominationStatus @default(PENDING)
  feedback   PeerFeedback?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([cycleId, revieweeId, reviewerId])
  @@index([tenantId])
  @@index([reviewerId, status])
  @@index([revieweeId])
  @@map("peer_nominations")
}

model PeerFeedback {
  id           String         @id @default(cuid())
  nominationId String         @unique
  nomination   PeerNomination @relation(fields: [nominationId], references: [id], onDelete: Cascade)
  rating       Decimal        @db.Decimal(3, 2)
  strengths    String         @db.Text
  growthAreas  String         @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("peer_feedbacks")
}

model ExEmployerReview {
  id             String     @id @default(cuid())
  employeeId     String
  employee       TenantUser @relation("EmployeeExReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  exCompany      String
  exManagerName  String
  exManagerEmail String
  token          String     @unique
  rating         Decimal?   @db.Decimal(3, 2)
  feedback       String?    @db.Text
  status         String     @default("PENDING") // PENDING | COMPLETED
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([employeeId])
  @@map("ex_employer_reviews")
}

model ExEmployeeRecord {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  email          String
  phone          String
  pan            String
  dob            String? // Birth Year YYYY
  designation    String
  department     String
  serviceStart   DateTime
  serviceEnd     DateTime
  exitReason     String
  techRating     Int
  attitudeRating Int
  conductValue   String
  feedback       String   @db.Text
  submittedBy    String // Creator's name
  status         String   @default("Submitted") // Submitted | Published
  docs           Json?
  isDeleted      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
  @@index([pan])
  @@index([email])
  @@map("ex_employee_records")
}

model NonJoinerRecord {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  email            String
  phone            String
  pan              String
  dob              String? // Birth Year YYYY
  designation      String
  department       String
  offerReleaseDate DateTime
  dateOfJoining    DateTime
  salary           String // LPA
  offerAccepted    String // Yes | No | Sent
  submittedBy      String // Creator's name
  status           String   @default("Submitted") // Submitted | Published
  docs             Json?
  feedback         String   @db.Text
  isDeleted        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId])
  @@index([pan])
  @@index([email])
  @@map("non_joiner_records")
}

// ── Policies & Digital Compliance ──────────────────────────────────────────

enum PolicyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PolicyAssignmentStatus {
  PENDING
  SIGNED
  OVERDUE
  REVOKED
}

model Policy {
  id              String             @id @default(cuid())
  tenantId        String
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title           String
  description     String?            @db.Text
  content         String             @db.Text
  category        String             @default("Compliance") // Compliance, HR Operations, Legal & Ethics, Security, etc.
  status          PolicyStatus       @default(DRAFT)
  version         Int                @default(1)
  pdfUrl          String?
  pdfOriginalName String?
  contentHash     String?
  effectiveDate   DateTime?
  dueDate         DateTime?
  publishedAt     DateTime?
  createdById     String
  createdBy       TenantUser         @relation("PolicyAuthor", fields: [createdById], references: [id])
  publishedById   String?
  publishedBy     TenantUser?        @relation("PolicyPublisher", fields: [publishedById], references: [id])
  assignments     PolicyAssignment[]
  acceptances     PolicyAcceptance[]
  auditLogs       PolicyAuditLog[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("policies")
}

model PolicyAssignment {
  id             String                 @id @default(cuid())
  tenantId       String
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policyId       String
  policy         Policy                 @relation(fields: [policyId], references: [id], onDelete: Cascade)
  userId         String
  user           TenantUser             @relation("UserPolicyAssignments", fields: [userId], references: [id], onDelete: Cascade)
  policyVersion  Int                    @default(1)
  assignedById   String?
  assignedBy     TenantUser?            @relation("PolicyAssigner", fields: [assignedById], references: [id])
  assignedAt     DateTime               @default(now())
  dueAt          DateTime?
  status         PolicyAssignmentStatus @default(PENDING)
  signedAt       DateTime?
  acceptanceId   String?                @unique
  acceptance     PolicyAcceptance?      @relation(fields: [acceptanceId], references: [id])
  reminderSentAt DateTime?
  reminderCount  Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([policyId, userId, policyVersion])
  @@index([tenantId])
  @@index([userId, status])
  @@index([policyId, status])
  @@map("policy_assignments")
}

model PolicyAcceptance {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policyId         String
  policy           Policy            @relation(fields: [policyId], references: [id], onDelete: Cascade)
  policyVersion    Int
  assignmentId     String            @unique
  assignment       PolicyAssignment?
  userId           String
  user             TenantUser        @relation("UserPolicyAcceptances", fields: [userId], references: [id], onDelete: Cascade)
  signedAt         DateTime          @default(now())
  ipAddress        String
  userAgent        String            @db.Text
  contentHash      String?
  complianceCheck  String            @default("Verified Audit")
  legalDeclaration String            @db.Text
  createdAt        DateTime          @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([policyId])
  @@map("policy_acceptances")
}

model PolicyAuditLog {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policyId    String?
  policy      Policy?    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  actorUserId String
  actor       TenantUser @relation("PolicyAuditActor", fields: [actorUserId], references: [id])
  action      String // POLICY_CREATED | POLICY_UPDATED | POLICY_PUBLISHED | POLICY_ASSIGNED | POLICY_SIGNED | POLICY_ARCHIVED | POLICY_REMINDER_SENT
  details     String?    @db.Text
  ipAddress   String?
  userAgent   String?    @db.Text
  metadata    Json?
  createdAt   DateTime   @default(now())

  @@index([tenantId])
  @@index([policyId])
  @@map("policy_audit_logs")
}

model HubEvent {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  date        String
  time        String?
  location    String?
  description String     @db.Text
  isFeatured  Boolean    @default(true)
  createdById String
  createdBy   TenantUser @relation("EventCreator", fields: [createdById], references: [id], onDelete: Cascade)
  postedBy    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([tenantId])
  @@index([createdById])
  @@map("hub_events")
}

model PasswordResetToken {
  id        String     @id @default(cuid())
  userId    String
  user      TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String     @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}
// ── Corporate Gallery ───────────────────────────────────────────────────────

model GalleryPost {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   TenantUser       @relation("GalleryPostUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  title        String
  category     String           @default("Socials") // Socials | Hackathon | Retreat | Awards | Townhall | Onboarding | Other
  imageUrl     String
  likeCount    Int              @default(0)
  commentCount Int              @default(0)
  isActive     Boolean          @default(true)
  likes        GalleryLike[]
  comments     GalleryComment[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([tenantId])
  @@index([uploadedById])
  @@index([tenantId, category])
  @@map("gallery_posts")
}

model GalleryLike {
  id        String      @id @default(cuid())
  tenantId  String
  postId    String
  post      GalleryPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      TenantUser  @relation("GalleryLikeUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("gallery_likes")
}

model GalleryComment {
  id        String      @id @default(cuid())
  tenantId  String
  postId    String
  post      GalleryPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    TenantUser  @relation("GalleryCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  text      String      @db.Text
  createdAt DateTime    @default(now())

  @@index([postId])
  @@index([authorId])
  @@map("gallery_comments")
}

// ─── Department Master List ───────────────────────────────────────────────────
// Tenant-scoped, RBAC-managed list of departments.
// Used to drive dropdowns across Employee Records, UER Team, Leave, etc.
// Names are stored as strings on employee records (no FK) — renaming a dept
// does NOT retroactively change historical employee records.
model Department {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String                        // e.g. "Engineering", "Design"
  description String?
  color       String?                       // optional hex e.g. "#6366f1"
  isActive    Boolean  @default(true)       // soft-delete — false = archived
  createdBy   String?                       // TenantUser.id (nullable for seeded)
  sortOrder   Int      @default(0)          // for custom ordering in the dropdown
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name])               // no duplicate names within a tenant
  @@index([tenantId, isActive])
  @@map("departments")
}
