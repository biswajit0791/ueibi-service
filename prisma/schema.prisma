  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   TenantUser       @relation("GalleryPostUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  title        String
  category     String           @default("Socials") // Socials | Hackathon | Retreat | Awards | Townhall | Onboarding | Other
  imageUrl     String
  likeCount    Int              @default(0)
  commentCount Int              @default(0)
  isActive     Boolean          @default(true)
  likes        GalleryLike[]
  comments     GalleryComment[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([tenantId])
  @@index([uploadedById])
  @@index([tenantId, category])
  @@map("gallery_posts")
}

model GalleryLike {
  id        String      @id @default(cuid())
  tenantId  String
  postId    String
  post      GalleryPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      TenantUser  @relation("GalleryLikeUser", fields: [userId], references: [id], onDelete: Cascade)
